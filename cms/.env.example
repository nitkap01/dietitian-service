# PostgreSQL connection string (local example)
DATABASE_URL=postgres://user@localhost:5432/dietitian_cms

# Optional AI key fallbacks (used only when no key is set in Settings). The one
# matching the provider selected in Settings is used. Preferred: set the key +
# provider in Settings (no restart needed). Without any key, detection uses a
# free heuristic fallback.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Login credentials for the CMS
CMS_USERNAME=admin
CMS_PASSWORD=changeme123
# Secret for signing session cookies (generate a random string)
SESSION_SECRET=your-very-secret-key-here-change-in-production
